
DJANGO_SECRET_KEY=example_secret_key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# To open the development site from another machine by name (e.g. http://macbookpro:8080), add the name
# to both; `npm run dev` accepts the same hosts:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,macbookpro
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://macbookpro:8080

# Database: empty = SQLite (backend/db.sqlite3). For PostgreSQL:
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=mtz_site
# DJANGO_DB_USER=mtz_site
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432

EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=SG.-api.key.example
EMAIL_USE_TLS=true

DEFAULT_FROM_EMAIL=Metricaz <contato@metricaz.com>
CONTACT_DIGEST_TO=comercial@metricaz.com
